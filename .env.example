# ── Shared suite settings ────────────────────────────────────────────
# Values every Argus service on a host shares (the GPU broker's URL and token,
# HF_TOKEN, and where the other services are: ARGUS_NUDENET_URL,
# ARGUS_PUPPET_URL, ARGUS_COMFYUI_URL, ARGUS_XTTS_URL, ARGUS_TTS_URL) can live
# once in the suite file instead of here: ~/.config/argus/suite.env (mode 600;
# `python -m argus_cortex.settings --init` creates it), mounted read-only at
# /etc/argus/suite.env in a container. Anything set in this file or the
# environment still wins. Proof's own variable for a service (PROOF_NUDENET_URL)
# wins over the suite-wide one, and `off` turns that service off for proof.

# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-proof FastAPI server (peer to lens :8100,
# curator :8101, quarry :8102, forge :8103).
PROOF_PORT=8104

# ── Generation backend ───────────────────────────────────────────────
# Which engine generates the eval grid (argus_proof.backends.get_backend).
# Swapping this changes nothing in scoring/report code.
#   comfyui   — a running ComfyUI instance
#   diffusers — in-process diffusers SDXL pipeline (needs the [diffusers] extra)
#   a1111     — an AUTOMATIC1111 / SD.Next /sdapi server
#   remote    — a hosted/cloud endpoint that speaks the proof wire
PROOF_BACKEND=comfyui

# Local model directory (for comfyui / diffusers / a1111 — checkpoints + LoRAs
# are resolved and SHA256-pinned into the manifest from here). GET /models lists
# <dir>/checkpoints and <dir>/loras (the ComfyUI layout). Several roots may be
# given PATH-style (dir1:dir2), mirroring ComfyUI's extra_model_paths trees.
PROOF_MODELS_DIR=~/models

# ComfyUI workflow template (API-format graph with $placeholders), used for every
# checkpoint. Unset = the packaged templates, picked by the checkpoint's family
# folder: checkpoints/flux/... -> comfyui_flux_lora.json, anything else ->
# comfyui_sdxl_lora.json. The Flux template loads t5xxl_fp8_e4m3fn, clip_l and ae
# by name from ComfyUI's clip/ and vae/ folders.
#PROOF_WORKFLOW_TEMPLATE=/path/to/workflow.json

# ── Storage ──────────────────────────────────────────────────────────
# Where scored EvalReports live (<run_id>.json). Compose mounts a volume here.
#ARGUS_PROOF_REPORTS_DIR=reports
# Where generated runs land (<run_id>/ with manifest.json + images); also the
# root GET /report/{run_id}/image/{image_id} serves from.
#ARGUS_PROOF_RUNS_DIR=runs
# Where curator exports are read from (GET /exports + POST /run/stream's
# `export` field name-resolves under this root).
#ARGUS_PROOF_EXPORTS_DIR=/data/out

# Replay/demo mode (issue #45): serve stored reports read-only and 403 all live
# GPU eval + writes — for the GPU-less public demo host. Point the two dirs above
# at the seeded "tape" reports/runs when this is on. GET /health echoes the flag.
#ARGUS_PROOF_READ_ONLY=1

# Dev mode (issue #59): register POST /purge and POST /purge/{run_id}, which
# delete runs and their reports (body {"confirm": "purge"}). Off by default —
# reports are the evaluation record. Compose sets it from DEVMODE.
#ARGUS_PROOF_DEVMODE=1

# ── GPU leases (argus-iris broker) ───────────────────────────────────
# Host-wide, read by argus-cortex: every argus service on the host must agree.
# Unset = no gating. The URL and the token are all it takes: the URL selects
# the broker, and the tenant comes from gpu-tenant.yaml (the image ships it at
# /app/gpu-tenant.yaml), which the server registers at startup. The comfyui and
# diffusers backends take one batch lease per run and give it back between seeds
# when the broker asks.
#ARGUS_GPU_BROKER_URL=http://<GPU_BROKER_HOST>:8120
# Secret: the shared caller token. Set it in the host's .env, never in a repo.
#ARGUS_GPU_BROKER_TOKEN=

# HTTP backends — the engine's base URL. Without COMFYUI_BASE_URL the suite-wide
# ARGUS_COMFYUI_URL is used, then http://127.0.0.1:8188.
COMFYUI_BASE_URL=http://127.0.0.1:8188
A1111_BASE_URL=http://127.0.0.1:7860

# ── Likeness scoring ─────────────────────────────────────────────────
# The DINOv2 model the likeness scorer embeds images with (identity for masked or
# non-human subjects and scenes, vs the export's references/): a Hugging Face id,
# or a local save_pretrained dir for an offline host. The weights file it loads is
# pinned by SHA256 in the report's scorer provenance. [score] extra.
#PROOF_LIKENESS_MODEL=facebook/dinov2-base

# ── Safety scoring ───────────────────────────────────────────────────
# NudeNet server for the safety scorer (its origin; /infer is appended). The
# suite's shared one runs the 640m detector: argus-retina's
# ghcr.io/smk762/argus-retina-nudenet, on morpheus :8130. The upstream
# ghcr.io/notai-tech/nudenet image is 320n, which scores differently; the report
# records which detector ran. Unset here = the suite-wide ARGUS_NUDENET_URL; with
# neither, the safety scorer is skipped. A URL that is set but malformed is an
# error, not a skipped scorer. Proof never imports NudeNet (AGPL-3.0).
#PROOF_NUDENET_URL=http://morpheus:8130
#PROOF_NUDENET_TIMEOUT=30

# Pose (#122): the argus-puppet service (its origin) for the run-level pose block
# (EvalReport.pose: pose diversity, and pose-copying evidence against the training
# frames when the export is readable here) that `gate --min-pose-diversity` reads.
# Only this host is ever contacted, redirects are not followed, and a busy 503 is
# retried a few times. Unset here = the suite-wide ARGUS_PUPPET_URL; with
# neither, no pose block (warned about; `--require-scorers pose` refuses). A URL
# that is set but not an absolute http(s) URL is an error. Puppet down or erroring never fails a run. Timeout is per read, in
# seconds; each call's overall deadline is three times it.
#PROOF_PUPPET_URL=http://<PUPPET_HOST>:8220
#PROOF_PUPPET_TIMEOUT=60

# remote (cloud) backend — the hosted generation endpoint + its bearer token.
PROOF_REMOTE_URL=https://your-proof-gen.example.com
PROOF_REMOTE_API_KEY=

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
